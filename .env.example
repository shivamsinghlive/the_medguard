# Copy to .env (never committed) to configure MedGuard Explorer on your laptop.
# Real environment variables override these, as on Render.

# AI provider: ollama (local, default) | openai (Groq or another OpenAI-compatible API) | anthropic | off
MEDGUARD_AI_PROVIDER=openai
MEDGUARD_AI_BASE_URL=https://api.groq.com/openai/v1
MEDGUARD_AI_MODEL=llama-3.1-8b-instant
# Paste your key from https://console.groq.com/keys after the = sign, with no quotes or spaces.
MEDGUARD_AI_API_KEY=
